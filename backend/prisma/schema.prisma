model Test {
  id                    String         @id @default(uuid())
  name                  String
  showResultImmediately Boolean        @default(false)
  proctoringEnabled     Boolean        @default(false)
  createdAt             DateTime       @default(now())
  orgId                 String
  rulesId               String
  isPublished           Boolean        @default(false)
  endTime               DateTime?
  isActive              Boolean        @default(false)
  startTime             DateTime?
  totalDuration         Int?
  resultPublishTime     DateTime?
  durationMode          DurationMode   @default(GLOBAL)
  drives                Drive[]
  submissions           Submission[]
  organization          Organization   @relation(fields: [orgId], references: [id])
  rules                 Rules          @relation(fields: [rulesId], references: [id])
  questions             TestQuestion[]
  sections              TestSection[]
}

model TestQuestion {
  id                 String @id @default(uuid())
  testId             String
  sectionId          String
  originalQuestionId String
  order              Int
  marks              Int
  negativeMarks      Int
  snapshot           Json
  test               Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model TestSection {
  id        String  @id @default(uuid())
  timeLimit Int
  testId    String
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  test      Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model Section {
  id           String        @id @default(uuid())
  sectionName  String
  orgId        String
  isActive     Boolean       @default(true)
  description  String?
  type         SectionType   @default(MCQ)
  questions    Question[]
  testSections TestSection[]
}

model Question {
  id                  String               @id @default(uuid())
  sectionId           String
  type                QuestionType
  difficulty          DifficultyLevel
  correctAnswer       String?
  allowedFor          QuestionUsage
  codingMeta          Json?
  createdBy           String
  creatorRole         CreatorRole
  isActive            Boolean              @default(true)
  orgId               String
  questionText        String
  marks               Int                  @default(1)
  order               Int                  @default(1)
  parentQuestionId    String?
  createdAt           DateTime             @default(now())
  codingQuestion      CodingQuestion?
  codingSubmissions   CodingSubmission[]
  options             Option[]
  passageDropdownMeta PassageDropdownMeta?
  passageWritingMeta  PassageWritingMeta?
  parentQuestion      Question?            @relation("ParagraphChildren", fields: [parentQuestionId], references: [id])
  childQuestions      Question[]           @relation("ParagraphChildren")
  section             Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers             SubmissionAnswer[]
  unseenParagraphMeta UnseenParagraphMeta?
}

model Submission {
  id                String             @id @default(uuid())
  studentId         String
  testId            String
  score             Int?
  submittedAt       DateTime?
  status            SubmissionStatus
  startedAt         DateTime           @default(now())
  codingSubmissions CodingSubmission[]
  student           Student            @relation(fields: [studentId], references: [id])
  test              Test               @relation(fields: [testId], references: [id])
  answers           SubmissionAnswer[]
}

model SubmissionAnswer {
  id             String     @id @default(uuid())
  submissionId   String
  questionId     String
  selectedAnswer String?
  isCorrect      Boolean?
  marksObtained  Int        @default(0)
  question       Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submission     Submission @relation(fields: [submissionId], references: [id])

  @@unique([submissionId, questionId])
}

model PracticeSet {
  id           String     @id @default(uuid())
  name         String
  orgId        String
  sectionTimer Int
  rulesId      String
  visibility   Visibility
  questionIds  Json
  rules        Rules      @relation(fields: [rulesId], references: [id])
}

model Rules {
  id               String        @id @default(uuid())
  totalMarks       Int
  marksPerQuestion Int?
  negativeMarking  Boolean
  negativeMarks    Int?
  practiceSets     PracticeSet[]
  tests            Test[]
}

model Drive {
  id          String         @id @default(uuid())
  companyId   String
  testId      String
  isOpenDrive Boolean        @default(false)
  startDate   DateTime
  endDate     DateTime
  description String?
  company     Organization   @relation(fields: [companyId], references: [id])
  test        Test           @relation(fields: [testId], references: [id])
  colleges    DriveCollege[]
}

model DriveCollege {
  id        String @id @default(uuid())
  driveId   String
  collegeId String
  drive     Drive  @relation(fields: [driveId], references: [id])
}

model ProctoringEvent {
  id                 String   @id @default(uuid())
  userId             String
  orgId              String
  orgType            String
  cameraActive       Boolean
  audioActive        Boolean
  tabSwitched        Boolean
  warningCount       Int
  maxWarningsAllowed Int
  timestamp          DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  orgId     String
  action    String
  ipAddress String
  location  String
  timestamp DateTime @default(now())
}

model CodingSubmission {
  id           String     @id @default(uuid())
  userId       String
  code         String
  language     String
  score        Int        @default(0)
  feedback     String?
  createdAt    DateTime   @default(now())
  questionId   String
  resultMeta   Json?
  submissionId String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  message     String
  type        String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  optionCode String
  optionText String
  isCorrect  Boolean
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model CodingQuestion {
  id               String   @id @default(uuid())
  questionId       String   @unique
  constraints      String?
  inputFormat      String?
  outputFormat     String?
  sampleInput      String?
  sampleOutput     String?
  testCases        Json
  timeLimitMs      Int      @default(1000)
  memoryLimitMb    Int      @default(256)
  allowedLanguages Json
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model PassageWritingMeta {
  id                String   @id @default(uuid())
  questionId        String   @unique
  minWords          Int?
  maxWords          Int?
  allowManualReview Boolean  @default(true)
  question          Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model PassageDropdownMeta {
  id         String   @id @default(uuid())
  questionId String   @unique
  content    String
  blanks     Json
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model UnseenParagraphMeta {
  id           String   @id @default(uuid())
  questionId   String   @unique
  passage      String
  subQuestions Json?
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

enum OrgType {
  COLLEGE
  COMPANY
}

enum UserRole {
  SUPER_ADMIN
  COLLEGE_ADMIN
  COMPANY_ADMIN
  STUDENT
  INSTRUCTOR
}

enum CollegeType {
  ENGINEERING
  DEGREE
  POLYTECHNIC
  OTHER
}

enum TestType {
  APTITUDE
  CODING
  MIXED
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MCQ
  MCQ_SINGLE
  MCQ_MULTIPLE
  CODING
  PASSAGE_WRITING
  PASSAGE_DROPDOWN
  UNSEEN_PARAGRAPH
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

enum QuestionUsage {
  PRACTICE
  TEST
  BOTH
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum EvaluationMode {
  COMPILER
  MANUAL
  AI
}

enum CreatorRole {
  ADMIN
  COMPANY
}

enum SectionType {
  MCQ
  CODING
  PASSAGE_WRITING
  PASSAGE_DROPDOWN
  UNSEEN_PARAGRAPH
}

enum DurationMode {
  GLOBAL
  SECTION
}
